<!DOCTYPE html>

<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>J.A.R.V.I.S.</title>

<style>

* { box-sizing: border-box; }

body {

  margin: 0;

  min-height: 100vh;

  background: #07111e;

  color: #e8f7ff;

  font-family: Arial, sans-serif;

  display: flex;

  justify-content: center;

  align-items: center;

  padding: 20px;

}

.container {

  width: 100%;

  max-width: 750px;

  text-align: center;

  background: #0d1b2a;

  border: 1px solid #174767;

  border-radius: 20px;

  padding: 30px;

  box-shadow: 0 0 35px #087ca044;

}

h1 {

  color: #56d9ff;

  letter-spacing: 8px;

  font-size: 38px;

}

.status {

  color: #55d9a6;

  font-size: 13px;

  letter-spacing: 3px;

}

.circle {

  width: 145px;

  height: 145px;

  margin: 30px auto;

  border: 3px solid #36cfff;

  border-radius: 50%;

  display: flex;

  justify-content: center;

  align-items: center;

  font-size: 48px;

  color: #56d9ff;

  box-shadow: 0 0 30px #00bfff55;

}

#chat {

  height: 220px;

  overflow-y: auto;

  background: #071421;

  border-radius: 12px;

  padding: 15px;

  text-align: left;

  margin-bottom: 15px;

}

.message {

  margin: 12px 0;

  line-height: 1.5;

}

.user { color: #56d9ff; }

.jarvis { color: #55d9a6; }

input {

  width: 72%;

  padding: 14px;

  border-radius: 9px;

  border: 1px solid #26749a;

  background: #071421;

  color: white;

  font-size: 15px;

}

button {

  padding: 13px 17px;

  margin: 5px;

  border: 0;

  border-radius: 9px;

  background: #087ca8;

  color: white;

  cursor: pointer;

  font-size: 14px;

}

button:hover { background: #10a9d7; }

.notes {

  color: #a9bfd0;

  font-size: 13px;

  margin-top: 20px;

}

</style>

</head>

<body>

<div class="container">

  <h1>J.A.R.V.I.S.</h1>

  <div class="status" id="status">● SISTEMA INICIADO</div>

  <div class="circle">J</div>

  <div id="chat">

    <div class="message jarvis">

      JARVIS: Buenos días. Sistemas inicializados.

      ¿En qué puedo ayudarte?

    </div>

  </div>

  <input id="message" placeholder="Escribe un mensaje...">

  <button onclick="sendMessage()">Enviar</button>

  <button onclick="listen()">🎙 Hablar</button>

  <div class="notes">

    ASISTENTE PERSONAL · PROTOTIPO 1.0

  </div>

</div>

<script>

const chat = document.getElementById("chat");

const input = document.getElementById("message");

const statusText = document.getElementById("status");

function addMessage(text, type) {

  const div = document.createElement("div");

  div.className = "message " + type;

  div.textContent = (type === "user" ? "TÚ: " : "JARVIS: ") + text;

  chat.appendChild(div);

  chat.scrollTop = chat.scrollHeight;

}

function speak(text) {

  if (!("speechSynthesis" in window)) return;

  window.speechSynthesis.cancel();

  const voice = new SpeechSynthesisUtterance(text);

  voice.lang = "es-ES";

  voice.rate = 1;

  window.speechSynthesis.speak(voice);

}

function reply(text) {

  addMessage(text, "jarvis");

  speak(text);

}

function sendMessage() {

  const text = input.value.trim();

  if (!text) return;

  addMessage(text, "user");

  input.value = "";

  const command = text.toLowerCase();

  let response;

  if (command.includes("hola")) {

    response = "Hola. Es un placer volver a escucharte.";

  } else if (command.includes("cómo estás")) {

    response = "Todos mis sistemas funcionan correctamente.";

  } else if (command.includes("hora")) {

    response = "La hora actual es " +

      new Date().toLocaleTimeString("es-ES");

  } else if (command.includes("fecha")) {

    response = "Hoy es " +

      new Date().toLocaleDateString("es-ES");

  } else if (command.includes("ayuda")) {

    response = "Puedes preguntarme la hora, la fecha o pedirme que guarde una nota.";

  } else if (command.startsWith("guarda nota ")) {

    const note = text.substring(12).trim();

    if (note) {

      const notes = JSON.parse(localStorage.getItem("jarvis_notes") || "[]");

      notes.push(note);

      localStorage.setItem("jarvis_notes", JSON.stringify(notes));

      response = "Nota guardada correctamente.";

    } else {

      response = "Dime qué nota quieres guardar.";

    }

  } else if (command.includes("mis notas")) {

    const notes = JSON.parse(localStorage.getItem("jarvis_notes") || "[]");

    response = notes.length

      ? "Tus notas son: " + notes.join(". ")

      : "Todavía no tienes notas guardadas.";

  } else {

    response = "Todavía estoy aprendiendo. Esa función estará disponible en futuras versiones.";

  }

  setTimeout(() => reply(response), 300);

}

input.addEventListener("keydown", function(event) {

  if (event.key === "Enter") sendMessage();

});

function listen() {

  const Recognition = window.SpeechRecognition ||

                      window.webkitSpeechRecognition;

  if (!Recognition) {

    reply("El reconocimiento de voz no está disponible en este navegador.");

    return;

  }

  const recognition = new Recognition();

  recognition.lang = "es-ES";

  recognition.interimResults = false;

  statusText.textContent = "● ESCUCHANDO...";

  recognition.onresult = function(event) {

    input.value = event.results[0][0].transcript;

    statusText.textContent = "● SISTEMA INICIADO";

    sendMessage();

  };

  recognition.onerror = function() {

    statusText.textContent = "● ERROR DE MICRÓFONO";

  };

  recognition.onend = function() {

    if (statusText.textContent === "● ESCUCHANDO...") {

      statusText.textContent = "● SISTEMA INICIADO";

    }

  };

  recognition.start();

}

</script>

</body>

</html>
